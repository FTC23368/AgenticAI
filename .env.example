# API keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Models
MODEL_PLANNER=claude-opus-4-7
MODEL_PLAN_REVIEWER=gpt-4o
MODEL_EXECUTOR=claude-sonnet-4-6
MODEL_NARRATOR=claude-sonnet-4-6
MODEL_OUTPUT_REVIEWER=gpt-4o
MODEL_OUTPUT_REFINER=claude-sonnet-4-6

# Limits
MAX_ROWS=1000000
MAX_FILE_MB=100
MAX_TOKENS_PER_RUN=200000
MAX_PLAN_ROUNDS=2
MAX_OUTPUT_ROUNDS=2
MAX_EXECUTOR_STEPS=20

# Paths
RUNS_DIR=runs
